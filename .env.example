PORT=3000

# --- Ollama (recommended — local, no cloud quota) ---
EMBEDDING_PROVIDER=ollama
CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
VECTOR_SIZE=768
OLLAMA_MAX_PROMPT_CHARS=8000
OLLAMA_MAX_TOKENS=1024
OLLAMA_TEMPERATURE=0.3

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=enterprise_knowledge

# SharePoint
TENANT_ID=your_tenant_id
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
SHAREPOINT_SITE_ID=your-site-id
# Single task list (used when SP_TASKS_* not set)
SP_TASKS=your-tasks-list-id
SP_TASKS_SITE_TYPE=HHHH

# Per-site task lists (recommended — mirrors dashboard validSites)
# SP_TASKS_HHHH=<tasks-list-guid-on-HHHH-site>
# SP_TASKS_QA=<tasks-list-guid>
# SP_SITE_HHHH=<graph-site-id>
# SP_SITE_QA=<graph-site-id>

SP_MASTER_TASK=your-master-task-list-id
SP_TIMSHEET1=your-timesheet1-list-id
SP_TIMSHEET2=your-timesheet2-list-id
TIMEENTRIES_MONTHS=3

CORS_ORIGINS=https://hhhhteams.sharepoint.com,https://localhost:4321

# Optional: local Xenova embeddings (no Ollama)
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# VECTOR_SIZE=384

# Optional: Gemini chat
# CHAT_PROVIDER=gemini
# GEMINI_API_KEY=your_key
# GEMINI_CHAT_MODEL=gemini-2.0-flash-lite
