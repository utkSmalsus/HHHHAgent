{
  "name": "omt-ai-backend",
  "version": "1.0.0",
  "description": "Enterprise AI Orchestration Backend — SharePoint, Qdrant, HF embeddings, Gemini chat",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "ingest": "curl -s -X POST http://localhost:3000/api/ingest/all -H 'Content-Type: application/json'",
    "ingest:watch": "./scripts/ingest-with-progress.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@huggingface/inference": "^3.1.1",
    "@xenova/transformers": "^2.17.2",
    "@qdrant/js-client-rest": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  }
}
